# Values for scripts/smoke-test.sh. Copy this file to .env (which git ignores)
# and replace each <placeholder>. A check whose value is still a placeholder is
# skipped, so fill in only what you want to test.
#
# This file is read by bash: quote values that contain spaces. It is not where
# tokens go; see docs/authentication.md.

JIRA_ISSUE="<ISSUE-123>"            # an issue you can see, e.g. PROJ-123
JIRA_JQL="assignee = currentUser() ORDER BY updated DESC"
JIRA_ISSUE_TYPE="Task"              # a type that issue's project lets you create (name or id)

BITBUCKET_PROJECT="<project-key>"   # e.g. PROJ
BITBUCKET_REPO="<repo-slug>"        # e.g. my-service
BITBUCKET_PR="<pr-number>"          # a pull request in that repo, e.g. 42
BITBUCKET_SEARCH="<search-text>"    # a string you know is in some repo
# Only used when builds and deployments are on (no `ci = false` under [bitbucket]).
BITBUCKET_COMMIT="<commit-hash>"    # a commit with CI builds, e.g. the PR's latest_commit
BITBUCKET_DEPLOY_KEY="<deployment-key>"
BITBUCKET_DEPLOY_ENV="<environment-key>"
BITBUCKET_DEPLOY_RUN="<sequence-number>"

CONFLUENCE_SPACE="<space-key>"      # e.g. OPS
CONFLUENCE_PAGE="<page-id>"         # a page you can see (the number in its URL)

OUTLOOK_SEARCH="<search-text>"      # a word you know is in some mail, for outlook_mail_search_messages

# Answers to the helpdesk's incident form for a dry-run create, as JSON keyed by question
# name, label, or label in snake_case (servicenow_get_incident_form lists them). Answers already in
# [servicenow.incident_defaults] can be left out. Single quotes keep the JSON intact.
SERVICENOW_ANSWERS='<incident-answers>'

# The service catalog: words to search for, and an item (its sys_id or exact name) with
# answers to its form, as JSON, for a dry-run order. servicenow_get_catalog_form lists
# the questions; answers in [servicenow.order_defaults] can be left out.
SERVICENOW_SEARCH="<catalog-search>"
SERVICENOW_ORDER_ITEM="<catalog-item>"
SERVICENOW_ORDER_ANSWERS='<order-answers>'
